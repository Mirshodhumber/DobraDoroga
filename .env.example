# ---- AI provider (optional; financial checks work without it) ----
ROADWATCH_API_KEY=
ROADWATCH_MODEL=gemini-3.8-flash
ROADWATCH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Other OpenAI-compatible options:
#   OpenAI:  ROADWATCH_MODEL=gpt-5.4-mini   ROADWATCH_BASE_URL=https://api.openai.com/v1
#   Ollama:  ROADWATCH_MODEL=qwen3.8:27b    ROADWATCH_BASE_URL=http://localhost:11434/v1  ROADWATCH_API_KEY=ollama

# ---- Access control (set this before exposing the app to the internet) ----
# The administrator's bootstrap key. Team members get email + password accounts via invite links from
# "Team & access" in the app (roles: viewer, investigator, counsel, admin). Rotating this key signs everyone out.
ROADWATCH_ACCESS_KEY=
# Self-registration: open = anyone can create an account (role below; admin can promote); invite = admin invites only.
ROADWATCH_SIGNUP=invite
ROADWATCH_SIGNUP_ROLE=viewer
# Guest mode: on = anyone who has the address can enter without an account and do what an investigator can
# (create and delete cases, pull data, run AI investigations, export) except post in the discussion.
# Leave off unless you accept that; the daily AI limit below still caps investigations.
ROADWATCH_GUEST=off
# Public address used in invite links (defaults to the request URL); optional SMTP so invites and resets are emailed.
# ROADWATCH_PUBLIC_URL=https://roadwatch.example.org
# ROADWATCH_SMTP_HOST=smtp.example.org
# ROADWATCH_SMTP_PORT=587
# ROADWATCH_SMTP_USER=
# ROADWATCH_SMTP_PASSWORD=
# ROADWATCH_MAIL_FROM=roadwatch@example.org

# ---- Limits & storage ----
ROADWATCH_DAILY_AI_LIMIT=40
# ROADWATCH_DB=/absolute/path/roadwatch.sqlite3
# ROADWATCH_CACHE=/absolute/path/cache   # downloaded open-data files; defaults next to the database

# ---- Optional: MongoDB instead of the SQLite file (pip install '.[mongo]') ----
# Cases, accounts and discussion go to MongoDB when this is set; ROADWATCH_DB is then ignored.
# Copy an existing SQLite database across with: python -m roadwatch.migrate_mongo
# ROADWATCH_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# ROADWATCH_MONGODB_DB=roadwatch   # database name; defaults to the one in the URI, else "roadwatch"
#
# Search by meaning (Atlas Vector Search; needs ROADWATCH_MONGODB_URI). The text of every evidence page is sent
# once to this embedding model, on any OpenAI-compatible /embeddings endpoint; key and URL default to the ones above.
# ROADWATCH_EMBED_MODEL=gemini-embedding-001
# ROADWATCH_EMBED_API_KEY=
# ROADWATCH_EMBED_BASE_URL=
# ROADWATCH_EMBED_DIMENSIONS=768

# Only needed when a local dev proxy rewrites the Host header (e.g. an IDE preview).
# ROADWATCH_ALLOWED_ORIGINS=http://127.0.0.1:62706

# ---- Optional: more models, selectable in the Investigation tab ----
# Any ROADWATCH_<ID>_MODEL adds a choice; its _API_KEY/_BASE_URL fall back to the defaults above.
# ROADWATCH_LABEL=Gemini Flash (Google)
# ROADWATCH_NVIDIA_ULTRA_LABEL=Nemotron 3 Ultra (NVIDIA)
# ROADWATCH_NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# ROADWATCH_NVIDIA_ULTRA_BASE_URL=https://integrate.api.nvidia.com/v1
# ROADWATCH_NVIDIA_ULTRA_API_KEY=nvapi-...

# A model running on this machine (Ollama: `brew install ollama && ollama pull qwen3:14b`).
# Free and private; local models are slower, so give them a longer timeout.
# A 27B-class model needs `sudo sysctl iogpu.wired_limit_mb=19456` first on a 24 GB Mac
# (Metal caps GPU memory at ~17.3 GiB; the model alone is ~17.5 GiB).
# ROADWATCH_LOCAL_LABEL=Local qwen3:14b (this Mac, free)
# ROADWATCH_LOCAL_MODEL=qwen3:14b
# ROADWATCH_LOCAL_BASE_URL=http://localhost:11434/v1
# ROADWATCH_LOCAL_API_KEY=ollama
# ROADWATCH_LOCAL_TIMEOUT=300
#
# Or the roadwatch-fine-tuned model (see finetune/README.md - LoRA on Qwen3-14B,
# trained on validator-passed reports; served by `finetune/serve.sh` on :8080):
# ROADWATCH_LOCAL_LABEL=Roadwatch Qwen3-14B (fine-tuned, this Mac)
# ROADWATCH_LOCAL_MODEL=roadwatch-qwen3-14b
# ROADWATCH_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# ROADWATCH_LOCAL_API_KEY=local
# ROADWATCH_LOCAL_TIMEOUT=300
# Optional support assistant settings. Reuses the existing model provider by default.
# ROADWATCH_SUPPORT_PROVIDER=default
ROADWATCH_SUPPORT_DAILY_LIMIT=80
